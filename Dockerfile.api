# Multi-stage Dockerfile for FraudWatch FastAPI Backend
FROM python:3.12-slim AS base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements-api.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code, trained models, feature store, data, reports and governance
COPY api/ /app/api/
COPY models/ /app/models/
COPY src/ /app/src/
COPY feature_store/ /app/feature_store/
COPY data/ /app/data/
COPY reports/ /app/reports/
COPY k8s/ /app/k8s/
COPY mlflow.db /app/mlflow.db
COPY streaming/ /app/streaming/

ENV PYTHONUNBUFFERED=1
ENV PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000"]
