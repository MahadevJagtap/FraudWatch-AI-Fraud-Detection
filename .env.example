# ==============================================================================
# FraudWatch — Real-Time Financial Fraud Detection Platform
# Environment Configuration Template (.env.example)
# Copy to .env and adjust values for your environment.
# ==============================================================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
MODEL_PATH=models/fraud_xgb_model.json
PRE_AUTH_MODEL_PATH=models/leakage_free_xgb_model.json

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Kafka Broker & Topic Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=fraudwatch.transactions.raw
KAFKA_ALERTS_TOPIC=fraudwatch.alerts.fraud
KAFKA_GROUP_ID=fraudwatch_scoring_group
KAFKA_AUTO_OFFSET_RESET=earliest

# Feast Feature Store
FEAST_REPO_PATH=feature_store

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
